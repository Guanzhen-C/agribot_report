{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:fieldgate:machine-profile:1",
  "title": "FieldGate Machine Profile 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "identity", "machine", "upstream", "downstream", "safety", "routing", "devices"],
  "properties": {
    "format": { "const": "FGMP/1" },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "name", "author", "commissioned"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "author": { "type": "string", "minLength": 1, "maxLength": 64 },
        "manufacturer": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 512 },
        "commissioned": { "type": "boolean", "description": "False blocks actuator output; true is a commissioning record, not cryptographic authorization." },
        "legacyMachineId": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "legacyProtocolId": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "machine": {
      "type": "object", "additionalProperties": false, "required": ["type", "inputModel"],
      "properties": {
        "type": { "enum": ["tracked_differential", "differential", "ackermann"] },
        "inputModel": { "enum": ["native_percent", "calibrated_virtual_differential"] },
        "geometry": {
          "type": "object", "additionalProperties": false, "required": ["trackMm", "wheelbaseMm"],
          "properties": { "trackMm": { "type": "integer", "minimum": 100, "maximum": 10000 }, "wheelbaseMm": { "type": "integer", "minimum": 100, "maximum": 10000 } }
        },
        "calibration": {
          "type": "object", "additionalProperties": false,
          "required": ["wheelSpeedAt100PercentMmS", "maxSteeringMrad", "minimumMovingMmS"],
          "properties": {
            "wheelSpeedAt100PercentMmS": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "maxSteeringMrad": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "minimumMovingMmS": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        }
      }
    },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["protocol", "bus", "bitrate"],
      "properties": { "protocol": { "const": "three_in_one_can_v1" }, "bus": { "const": "CAN1" }, "bitrate": { "$ref": "#/definitions/bitrate" } }
    },
    "downstream": {
      "type": "object", "additionalProperties": false, "required": ["bus", "bitrate"],
      "properties": { "bus": { "const": "CAN0" }, "bitrate": { "$ref": "#/definitions/bitrate" } }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["commandTimeoutMs", "feedbackTimeoutMs", "neutralBeforeEnable", "requiredFeedbackIds"],
      "properties": {
        "commandTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 500 },
        "feedbackTimeoutMs": { "type": "integer", "minimum": 200, "maximum": 5000 },
        "neutralBeforeEnable": { "const": true },
        "requiredFeedbackIds": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/definitions/nativeFeedbackId" } }
      }
    },
    "routing": {
      "type": "object", "additionalProperties": false, "required": ["mode", "feedbackPassthroughIds", "messages"],
      "properties": {
        "mode": { "enum": ["passthrough", "mapped_can" ] },
        "feedbackPassthroughIds": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/definitions/nativeFeedbackId" } },
        "messages": { "type": "array", "maxItems": 16, "items": { "$ref": "#/definitions/message" } }
      }
    },
    "devices": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "category", "control", "feedback"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "category": { "enum": ["drive", "steering", "light", "fan", "pump", "shredder", "battery", "remote", "safety"] },
          "control": { "enum": ["none", "drive.leftPercent", "drive.rightPercent", "drive.forwardMmS", "drive.yawMradS", "drive.leftSteeringMrad", "drive.rightSteeringMrad", "lighting.headlight", "work.fanGear", "work.pumpGear", "work.shredderX100"] },
          "feedback": { "enum": ["none", "native_three_in_one"] },
          "feedbackFrameId": { "$ref": "#/definitions/nativeFeedbackId" },
          "outputMessageId": { "$ref": "#/definitions/canId" },
          "channel": { "type": "integer", "minimum": 0, "maximum": 31 }
        }
      }
    },
    "extensions": { "type": "object", "description": "Namespaced non-operational metadata only. No executable code or implicit runtime capabilities.", "patternProperties": { "^[a-z][a-z0-9_.-]+:[a-z][a-z0-9_.-]+$": {} }, "additionalProperties": false }
  },
  "definitions": {
    "bitrate": { "enum": [125000, 250000, 500000, 1000000] },
    "canId": { "type": "integer", "minimum": 1, "maximum": 2047 },
    "nativeFeedbackId": { "enum": [1280, 1281, 1330, 1331, 1332, 1456, 1458, 1459, 1460, 1616, 1618] },
    "message": {
      "type": "object", "additionalProperties": false, "required": ["id", "domain", "counter", "checksum", "base", "fields"],
      "properties": {
        "id": { "$ref": "#/definitions/canId" },
        "domain": { "enum": ["drive", "work"] },
        "counter": { "enum": ["none", "nibble6"] },
        "checksum": { "enum": ["none", "xor7"] },
        "base": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "fields": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/definitions/field" } }
      }
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "startBit", "bitLength", "signed", "byteOrder", "numerator", "denominator", "offset", "safeRaw"],
      "properties": {
        "source": { "enum": ["drive.leftPercent", "drive.rightPercent", "lighting.headlight", "work.fanGear", "work.pumpGear", "work.shredderX100", "drive.forwardMmS", "drive.yawMradS", "drive.leftSteeringMrad", "drive.rightSteeringMrad"] },
        "startBit": { "type": "integer", "minimum": 0, "maximum": 63 },
        "bitLength": { "type": "integer", "minimum": 1, "maximum": 16 },
        "signed": { "type": "boolean" },
        "byteOrder": { "enum": ["little", "big_byte_aligned"] },
        "numerator": { "type": "integer", "minimum": -100000, "maximum": 100000, "not": { "const": 0 } },
        "denominator": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "offset": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        "safeRaw": { "type": "integer", "minimum": -32768, "maximum": 65535 }
      }
    }
  }
}
