      <sensor name="n300pro_imu" type="imu">
        <pose>1.72 0 0.920368656051 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0008023</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0008023</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0008023</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.01091</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.01091</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.01091</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <plugin name="n300pro_imu_controller" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=imu/data</remapping>
          </ros>
          <frame_name>imu_link</frame_name>
        </plugin>
      </sensor>
      <sensor name="lslidar_c16_points" type="ray">
        <pose>1.95 0 1.35939866405 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.2792526803190927</min_angle>
              <max_angle>0.24434609527920614</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>30</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="c16_controller" filename="libgazebo_ros_velodyne_laser.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=lidar/points</remapping>
          </ros>
          <frame_name>lidar_link</frame_name>
          <organize_cloud>false</organize_cloud>
          <min_range>0.3</min_range>
          <max_range>30</max_range>
          <gaussian_noise>0.01</gaussian_noise>
        </plugin>
      </sensor>
      <sensor name="hikrobot_right_camera" type="camera">
        <pose>1.9753 0 1.47798566405 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <camera name="right_camera">
