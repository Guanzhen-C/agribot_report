          </distortion>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.003</stddev>
          </noise>
        </camera>
        <plugin name="hikrobot_camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/</namespace>
            <remapping>camera/image_raw:=camera/rgb/image_raw</remapping>
            <remapping>camera/camera_info:=camera/rgb/camera_info</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>right_camera_optical_frame</frame_name>
          <camera_info_url>package://agribot_ackermann_mppi/config/hikrobot_camera_640_sim.yaml</camera_info_url>
        </plugin>
      </sensor>
